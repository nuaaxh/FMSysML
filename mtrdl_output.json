        "name": "Loc mode become inactive",
        "kind": "Primitive",
        "initialValue": false
      },
      {
        "name": "Press AP button",
        "kind": "Primitive",
        "initialValue": false
      },
      {
        "name": "WS mode status become TRUE",
        "kind": "Primitive",
        "initialValue": false
      }
