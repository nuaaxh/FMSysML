        "kind": "Primitive",
        "initialValue": false
      },
      {
        "name": "FMCP TOGA button is pressed",
        "kind": "Primitive",
        "initialValue": false
      },
      {
        "name": "Press TOGA button",
        "kind": "Primitive",
        "initialValue": false
      },
      {
        "name": "FMCP issues an ALT hold Request",
        "kind": "Primitive",
        "initialValue": false
      },
      {
        "name": "Glideslope capture conditions are met",
        "kind": "Primitive",
        "initialValue": false
      },
      {
        "name": "VS knob is rotated",
        "kind": "Primitive",
        "initialValue": false
      },
      {
        "name": "Glideslope capture conditions are met",
        "kind": "Primitive",
        "initialValue": false
      },
      {
        "name": "any FD mode become active",
        "kind": "Derived",
        "derivation": {
          "vars": [
            "any lateral mode become active",
            "any vertical mode become active"
          ],
          "expression": "any lateral mode become active OR any vertical mode become active"
        },
        "initialValue": false
      },
      {
        "name": "any lateral mode become active",
        "kind": "Primitive",
        "initialValue": false
      },
      {
        "name": "any lateral mode become inactive",
        "kind": "Primitive",
        "initialValue": false
      },
      {
        "name": "any vertical mode become active",
        "kind": "Primitive",
        "initialValue": false
      },
      {
        "name": "AP become engaged",
        "kind": "Primitive",
        "initialValue": false
      },
      {
        "name": "AP fast disconnection happens",
        "kind": "Primitive",
        "initialValue": false
      },
      {
        "name": "FMCP APPR button was converted from disconnection to connection",
        "kind": "Primitive",
        "initialValue": false
      },
      {
        "name": "FMCP issues AP Engage Request",
        "kind": "Primitive",
        "initialValue": false
      },
