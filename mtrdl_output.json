      {
        "name": "AP become disengaged",
        "kind": "Primitive",
        "initialValue": false
      },
      {
        "name": "FD become disengaged",
        "kind": "Primitive",
        "initialValue": false
      },
      {
        "name": "Press APPR button",
        "kind": "Primitive",
        "initialValue": false
      },
      {
        "name": "FMCP issues an FLC Request",
        "kind": "Primitive",
        "initialValue": false
      },
      {
