  "modules": [
    {
      "name": "Aircraft State",
      "interfaces": {
        "outputs": {
          "vars": [
            "Altitude",
            "ASEL height",
            "minimum sensor configuration for AP/FD engagement is met",
            "ASEL height capture condition is met",
            "ASEL height is captured",
            "is Aircraft on air",
            "is Aircraft on ground"
          ],
          "events": [
            "ASEL height capture condition become met"
          ]
        }
      }
    },
    {
      "name": "AP",
      "interfaces": {
        "inputs": {
          "vars": [
            "AP_button connection"
          ],
          "events": [
            "AP fast disconnection happens",
            "FMCP issue AP Engage Request",
            "FMCP issues AP Engage Request"
          ]
        },
        "encapsulated": {
          "vars": [
            "AP Available Status"
          ]
        },
        "outputs": {
          "vars": [
            "AP Engage Status"
          ],
          "events": [
            "AP become engaged",
            "AP become disengaged"
          ]
        }
      }
    },
    {
      "name": "FD",
      "interfaces": {
        "inputs": {
          "events": [
            "any FD mode is connected"
          ]
        },
        "encapsulated": {
          "vars": [
            "FD Available Status"
          ]
        },
        "outputs": {
          "vars": [
            "FD Engage Status"
          ],
          "events": [
            "FD become disengaged"
          ]
        }
      }
    },
    {
      "name": "FMCP",
      "interfaces": {
        "inputs": {
          "events": [
            "Press AP button",
            "Press APPR button",
            "Press FLC button",
            "Press TOGA button"
          ]
        },
        "outputs": {
          "vars": [
            "AP_button connection",
            "APPR_button connection",
            "FLC_button connection",
            "TLA is in TOGA",
            "TOGA_button connection"
          ],
          "events": [
            "FMCP issues an FLC Request",
            "FMCP APPR button was converted from disconnection to connection",
            "FMCP TOGA button is pressed",
            "FMCP issues AP Engage Request"
          ]
        }
      }
    }
  ],
  "modes": [
    {
      "name": "ALT_mode",
      "interfaces": {
        "output": {
          "vars": [
            "ALT_mode is active"
          ]
