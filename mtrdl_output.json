  "processes": [
    {
      "name": "AP Engage",
      "owner": "AP",
      "sets": {
        "read": [
          "AP Engage Status",
          "AP_button connection"
        ],
        "write": [
          "AP Engage Status"
        ],
        "trigger": [
          "FMCP issue AP Engage Request",
          "AP fast disconnection happens",
          "FMCP issues AP Engage Request"
        ]
      },
      "states": [
        "AP Disengage",
        "AP Engage"
      ],
      "statePredicates": {
        "AP Disengage": "AP Engage Status == false",
        "AP Engage": "AP Engage Status == true"
      },
      "transitions": [
        {
          "source": "AP Disengage",
          "target": "AP Engage",
          "triggerEvents": [
            "FMCP issue AP Engage Request"
          ],
          "actions": [
            {
              "var": "AP Engage Status",
              "expr": "true"
            }
          ]
        },
        {
          "source": "AP Engage",
          "target": "AP Disengage",
          "triggerEvents": [
            "AP fast disconnection happens",
            "FMCP issues AP Engage Request"
          ],
          "actions": [
            {
              "var": "AP Engage Status",
              "expr": "false"
            }
          ]
        }
      ]
    },
    {
      "name": "FD Engage status",
      "owner": "FD",
      "sets": {
        "read": [
          "FD Engage Status"
        ],
        "write": [
          "FD Engage Status"
        ],
        "trigger": [
          "any FD mode is connected"
        ]
      },
      "states": [
        "FD disengage",
        "FD engage"
      ],
      "statePredicates": {
        "FD disengage": "FD Engage Status == false",
        "FD engage": "FD Engage Status == true"
      },
      "transitions": [
        {
          "source": "FD disengage",
          "target": "FD engage",
          "triggerEvents": [
            "any FD mode is connected"
          ],
          "actions": [
            {
              "var": "FD Engage Status",
              "expr": "true"
            }
          ]
        }
      ]
    },
    {
      "name": "AP button Status",
      "owner": "FMCP",
      "sets": {
        "read": [
          "AP_button connection"
        ],
        "write": [
          "AP_button connection"
        ],
        "trigger": [
          "Press AP button"
        ]
      },
      "states": [
        "AP button Connection",
        "AP button Disconnection"
      ],
      "statePredicates": {
        "AP button Connection": "AP_button connection == true",
        "AP button Disconnection": "AP_button connection == false"
      },
      "transitions": [
        {
          "source": "AP button Connection",
          "target": "AP button Disconnection",
          "triggerEvents": [
            "Press AP button"
          ],
          "actions": [
            {
              "var": "AP_button connection",
              "expr": "false"
            }
          ]
        },
        {
          "source": "AP button Disconnection",
          "target": "AP button Connection",
          "triggerEvents": [
            "Press AP button"
          ],
          "actions": [
            {
              "var": "AP_button connection",
              "expr": "true"
            }
          ]
        }
      ]
    },
    {
      "name": "APPR button status",
      "owner": "FMCP",
      "sets": {
        "read": [
          "APPR_button connection"
        ],
        "write": [
          "APPR_button connection"
        ],
        "trigger": [
          "Press APPR button"
        ]
      },
      "states": [
        "button connection",
        "button disconnection"
      ],
      "statePredicates": {
        "button connection": "APPR_button connection == true",
        "button disconnection": "APPR_button connection == false"
      },
      "transitions": [
