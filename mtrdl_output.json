    },
    {
      "name": "FLC_mode",
      "interfaces": {
        "output": {
          "vars": [
            "FLC_mode is active"
          ]
        }
      }
    },
    {
      "name": "FPA_mode",
      "interfaces": {
        "entry": {
          "events": [
            "AP become disengaged",
            "AP become engaged",
            "ASEL height capture condition become met",
            "FD become disengaged",
            "FMCP APPR button was converted from disconnection to connection",
            "FMCP TOGA button is pressed",
            "FMCP issues an ALT hold Request",
            "FMCP issues an FLC Request",
            "Glideslope capture conditions are met",
            "Loc mode become inactive",
            "VS knob is rotated",
            "any lateral mode become inactive"
          ]
        },
        "run": {
          "vars": [
            "ALT_mode is active",
            "AP Engage Status",
            "APPR_button connection",
            "ASEL height capture condition is met",
            "ASEL_mode is active",
            "FD Engage Status",
            "FLC_button connection",
            "FLC_mode is active",
            "GA_mode is active",
            "GS_mode is active",
            "LOC_mode is active",
            "TOGA_button connection",
            "TO_mode is active",
            "VS_mode is active",
            "WS_mode is active",
            "lateral_mode is active",
            "vertical STDBY mode is active"
          ],
          "events": [
            "FMCP issues an FLC Request",
            "FMCP APPR button was converted from disconnection to connection",
            "FMCP TOGA button is pressed",
            "ASEL height capture condition become met",
            "AP become engaged",
            "any lateral mode become inactive",
            "AP become disengaged",
            "FD become disengaged",
            "Loc mode become inactive"
          ]
        },
        "output": {
          "vars": [
            "FPA_mode is active"
          ]
        }
      }
    },
    {
      "name": "GA_mode",
      "interfaces": {
        "output": {
          "vars": [
            "GA_mode is active"
          ]
        }
      }
    },
    {
      "name": "GS_mode",
      "interfaces": {
        "output": {
          "vars": [
            "GS_mode is active"
          ]
        }
      }
    },
    {
