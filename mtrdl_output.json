      "interfaces": {
        "output": {
          "vars": [
            "lateral_mode is active"
          ],
          "events": [
            "any lateral mode become inactive"
          ]
        }
      }
    },
    {
      "name": "LOC_mode",
      "interfaces": {
        "output": {
          "vars": [
            "LOC_mode is active"
          ],
          "events": [
            "Loc mode become inactive"
          ]
        }
      }
    },
    {
      "name": "Roll_mode",
      "interfaces": {
        "output": {
          "vars": [
            "Roll_mode is active"
          ]
        }
      }
    },
    {
      "name": "TO_mode",
      "interfaces": {
        "output": {
          "vars": [
            "TO_mode is active"
          ]
        }
      }
    },
    {
      "name": "vertical STDBY",
      "interfaces": {
        "run": {
          "vars": [
            "FPA_mode is active",
            "GS_mode is active"
          ]
        },
        "output": {
          "vars": [
            "vertical STDBY mode is active",
            "vertical STDBY mode is inactive"
          ]
        }
      }
    },
    {
      "name": "vertical_mode",
      "interfaces": {
        "output": {
          "vars": [
            "vertical_mode is active"
          ]
        }
      }
    },
    {
      "name": "VS_mode",
      "interfaces": {
        "output": {
          "vars": [
            "VS_mode is active"
          ]
        }
      }
    },
    {
      "name": "WS_mode",
      "interfaces": {
        "output": {
          "vars": [
            "WS_mode is active"
          ]
        }
      }
    }
  ],
